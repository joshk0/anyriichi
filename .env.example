# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Supabase (web + worker) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Worker only: Postgres connection via Supabase pooler (session mode)
DATABASE_URL=

# --- Worker ---
HTTP_ADDR=:8080
LOG_LEVEL=info
# Clamped to >= 20m (Tenhou usage rules)
TENHOU_POLL_INTERVAL=20m

# --- Platform credentials (M2+; never commit) ---
MAJSOUL_ACCOUNT=
MAJSOUL_PASSWORD=
